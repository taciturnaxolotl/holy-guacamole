	(footprint "Device:SolderLap_20AWG_1x02_2.6x4.0mm_P3.2mm"
		(layer "F.Cu")
		(uuid "e367527f-ab98-4f14-abe9-90b2c59ddced")
		(at 96.6 92.8 180)
		(descr "Two SMD lap-solder pads for 20 AWG wire (ESC battery feed). Pad 1 VBUS, pad 2 GND. Wire lies along the pad (N-S). No room for a zip-tie slot (board edge 0.3 mm E of pad 2, S beam N of the pads, ledge S): strain relief is the chassis wire clip on the S-ledge face plus an epoxy fillet over each joint.")
		(tags "solder wire lap SMD 20AWG")
